{
  "name": "ultra-pi",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "install:extensions": "for d in .pi/extensions/*/; do [ -f \"$d/package.json\" ] && (cd \"$d\" && npm ci --ignore-scripts); done"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.pi/skills"
    ],
    "themes": [
      "./.pi/themes"
    ]
  }
}
